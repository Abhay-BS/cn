#include <stdio.h>
#include <stdlib.h>
int main() {
 int i, n = 10; /* number of frames */
 printf("number of frames is %d ", n);
 for (i = 1; i <= n; i++) {
 printf("\nsending frames is %d", i);
 if (rand() % 5 == 0) { /* ack lost -> timeout */
 printf("\n waiting for 1 seconds\n");
 printf("\n sending frames %d\n", i); /* resend the frame */
 }
 printf("\n ack for frame %d\n", i);
 }
 printf("\n end of stop and wait protocol\n");
 return 0;
}

#include <stdio.h>
int main() {
 int w, f, i, a[50];
 printf("Enter window size: "); scanf("%d", &w);
 printf("\nEnter number of frames to transmit: "); scanf("%d", &f);
 printf("\nEnter %d frames: ", f);
 for (i = 1; i <= f; i++) scanf("%d", &a[i]);
 printf("\nWith sliding window protocol the frames will be sent in the following manner (assuming no corruption of frames)\n\n");
 printf("After sending %d frames at each stage sender waits for acknowledgement sent by the receiver\n\n", w);
 for (i = 1; i <= f; i++) {
 printf("%d ", a[i]);
 if (i % w == 0 || i == f) printf("\nAcknowledgement of above frames sent is received by sender\n\n");
 }
 return 0;
}

