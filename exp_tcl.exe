#include <stdio.h>
int main() {
 char a[50];
 int i, count = 0;
 printf("enter bit string : ");
 scanf("%s", a);
 printf("After stuffing : 01111110"); /* starting flag */
 for (i = 0; a[i]; i++) {
 putchar(a[i]);
 count = (a[i] == '1') ? count + 1 : 0; /* count consecutive 1s */
 if (count == 5) { /* five 1s -> insert 0 */
 putchar('0');
 count = 0;
 }
 }
 printf("01111110\n"); /* ending flag */
 return 0;
}

#include <stdio.h>
int main() {
 char a[100], s, e;
 int i;
 printf("Enter characters to be stuffed : "); scanf("%99s", a);
 printf("\nEnter a character that represents starting delimiter : "); scanf(" %c", &s);
 printf("\nEnter a character that represents ending delimiter : "); scanf(" %c", &e);
 printf("\nAfter stuffing : %c", s);
 for (i = 0; a[i]; i++) { putchar(a[i]); if (a[i] == s || a[i] == e) putchar(a[i]); }
 printf("%c\n", e);
 return 0;
}


#include <stdio.h>
int main() {
 int g[10][10], d[10], p[10], v[10] = {0}, n, s, i, j, u, m;
 printf("Enter no. of vertices:"); scanf("%d", &n);
 printf("\nEnter the adjacency matrix:\n");
 for (i = 0; i < n; i++) for (j = 0; j < n; j++) scanf("%d", &g[i][j]);
 printf("\nEnter the starting node:"); scanf("%d", &s);
 for (i = 0; i < n; i++) { d[i] = 9999; p[i] = s; }
 d[s] = 0;
 for (j = 0; j < n; j++) {
 m = 9999; u = -1;
 for (i = 0; i < n; i++) if (!v[i] && d[i] < m) { m = d[i]; u = i; }
 if (u < 0) break;
 v[u] = 1;
 for (i = 0; i < n; i++)
 if (g[u][i] && !v[i] && d[u] + g[u][i] < d[i]) { d[i] = d[u] + g[u][i]; p[i] = u; }
 }
 for (i = 0; i < n; i++) if (i != s && d[i] < 9999) {
 printf("\nDistance of node%d=%d\nPath=%d", i, d[i], i);
 for (j = i; j != s; ) { j = p[j]; printf("<-%d", j); }
 }
 printf("\n");
 return 0;
}


