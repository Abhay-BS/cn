#include <stdio.h>
#include <string.h>
char g[] = "10001000000100001", t[128], w[128];
int a, e, i, j;
void crc() { /* remainder ends in w+a */
 strcpy(w, t);
 for (i = 0; w[i + 16]; i++)
 if (w[i] == '1')
 for (j = 0; j < 17; j++) w[i + j] ^= g[j] & 1;
}
int main() {
 printf("\nEnter poly : "); scanf("%100s", t);
 printf("\nGenerating Polynomial is: %s", g);
 a = strlen(t);
 strcat(t, "0000000000000000"); /* add 16 zeros */
 printf("\nModified t[u] is : %s", t);
 crc();
 printf("\nChecksum is : %s", w + a);
 strcpy(t + a, w + a); /* data + checksum */
 printf("\nFinal Codeword is : %s", t);
 printf("\nTest Error detection 0(yes) 1(no) ? : "); scanf("%d", &e);
 if (e == 0) {
 printf("Enter position where error is to inserted : "); scanf("%d", &e);
 t[e] ^= 1; /* flip one bit */
 printf("Errorneous data : %s\n", t);
 }
 crc(); /* receiver side */
 printf(strchr(w + a, '1') ? "Error detected.\n" : "No Error Detected.\n");
 return 0;
}

